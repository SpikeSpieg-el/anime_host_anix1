# Supabase/Nhost backend used for auth and database
SUPABASE_URL=https://nhost.weebx.duckdns.org:8443
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Alternative env name that will also work:
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Port for the PvP Socket.io server
PORT=3001

# Comma-separated list of frontend origins allowed to connect via CORS.
# Must include the production domain and any dev URLs.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,https://weeb-x.com,https://www.weeb-x.com
