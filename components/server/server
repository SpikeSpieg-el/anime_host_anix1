const PORT = process.env.PORT || 3001
const SUPABASE_URL = process.env.SUPABASE_URL
const SUPABASE_SERVICE_KEY = process.env.SUPABASE_SERVICE_KEY
const ALLOWED_ORIGINS = process.env.ALLOWED_ORIGINS?.split(',') || ['http://localhost:3000']

const supabase = createClient(SUPABASE_URL, SUPABASE_SERVICE_KEY)

const httpServer = createServer()
const io = new Server(httpServer, {
  cors: {
    origin: ALLOWED_ORIGINS,
    methods: ['GET', 'POST'],
    credentials: true
  }
})

// In-memory state
const matchmakingQueue = new Map() // userId -> { socket, mmr, deckData }
const activeMatches = new Map() // matchId -> { player1, player2, state }
const userSockets = new Map() // userId -> socket
let globalMatchCounter = 0 // Match counter for cyclic empty locations

// Database cached data
let dbRules = []
let dbLocations = []
let lastDbUpdate = 0
const DB_REFRESH_INTERVAL = 1000 * 60 * 5 // 5 minutes

async function refreshDbCache() {
  try {
    const { data: rules } = await supabase.from('pvp_rules').select('*').eq('is_active', true)
    const { data: locations } = await supabase.from('pvp_locations').select('*, rules:pvp_location_rules(rule_id)').eq('is_active', true)
    
    if (rules) dbRules = rules
    if (locations) dbLocations = locations
    lastDbUpdate = Date.now()
    console.log(`[DB Cache] Refreshed: ${dbRules.length} rules, ${dbLocations.length} locations`)
  } catch (err) {
    console.error('[DB Cache] Refresh failed:', err)
  }
}

// Initial refresh
refreshDbCache()

// Middleware: Authenticate socket connections
io.use(async (socket, next) => {
  try {
    const token = socket.handshake.auth.token
    if (!token) {
      return next(new Error('Authentication token required'))
    }

    // Verify token with Supabase
    const { data: { user }, error } = await supabase.auth.getUser(token)
    
    if (error || !user) {
      console.error('[Auth] Authentication failed:', error?.message || 'No user found')
      return next(new Error('Invalid authentication token'))
    }

    socket.userId = user.id
    socket.userEmail = user.email

    console.log(`[Auth] User ${socket.userId} authenticated`)
    next()
  } catch (err) {
    console.error('[Auth] Authentication failed:', err.message)
    next(new Error('Invalid authentication token'))
  }
})

io.on('connection', (socket) => {
  const userId = socket.userId
  console.log(`[Connection] User ${userId} connected (${socket.id})`)

  userSockets.set(userId, socket)

  // Handle matchmaking queue join
  socket.on('join_queue', async (data) => {
    try {
      let { deck, leaderId, formation } = data

      // Validate deck
      if (!deck || deck.length !== 8) {
        return socket.emit('error', { message: 'Неверная колода: требуется ровно 8 карт' })
      }

      // Ensure all cards have role assigned
      deck = deck.map(card => ({
        ...card,
        role: card.role || getCardRole(card)
      }))

      // Get user's MMR from database
      const { data: ladderData, error } = await supabase
        .from('user_ladder')
        .select('mmr')
        .eq('user_id', userId)
        .single()

      if (error) {
        console.error('[Queue] Error fetching MMR:', error)
        return socket.emit('error', { message: 'Failed to join queue' })
      }

      const mmr = ladderData?.mmr || 1000

      // Add to queue
      matchmakingQueue.set(userId, {
        socket,
        mmr,
        deck,
        leaderId,
        formation,
        joinedAt: Date.now()
      })

      console.log(`[Queue] User ${userId} joined (MMR: ${mmr}, Queue size: ${matchmakingQueue.size})`)
      socket.emit('queue_joined', { queueSize: matchmakingQueue.size })

      // Try to find matches for everyone in queue
      findMatches()
    } catch (err) {
      console.error('[Queue] Error:', err)
      socket.emit('error', { message: 'Failed to join queue' })
    }
  })

  // Handle leaving queue
  socket.on('leave_queue', () => {
    if (matchmakingQueue.has(userId)) {
      matchmakingQueue.delete(userId)
      console.log(`[Queue] User ${userId} left queue`)
      socket.emit('queue_left')
    }
  })

  // Handle card placement during battle
  socket.on('place_cards', (data) => {
    const { matchId, placements } = data
    const match = activeMatches.get(matchId)

    if (!match) {
      return socket.emit('error', { message: 'Match not found' })
    }

    const isPlayer1 = match.player1.userId === userId
    const playerKey = isPlayer1 ? 'player1' : 'player2'

    // Log placement secret status for debugging
    console.log(`[Match ${matchId}] ${playerKey} placements:`, placements.map(p => ({ cardId: p.cardId, zoneId: p.zoneId, isSecret: p.isSecret })))

    // Validate: check if placements array is valid
    if (!Array.isArray(placements) || placements.length === 0) {
      console.log(`[Match ${matchId}] ${playerKey} sent invalid placements: not an array or empty`)
      return socket.emit('error', { message: 'Некорректные данные карт' })
    }

    // Validate: check if each placement has required fields
    const invalidPlacements = placements.filter(p => !p.cardId || !p.zoneId || typeof p.isSecret !== 'boolean')
    if (invalidPlacements.length > 0) {
      console.log(`[Match ${matchId}] ${playerKey} sent invalid placements:`, invalidPlacements)
      return socket.emit('error', { message: 'Некорректные данные карт: отсутствуют обязательные поля' })
    }

    // Validate: check if cards were already used in previous rounds
    const existingCardIds = (match[playerKey].board || []).map(p => p.cardId)
    const duplicateCardIds = placements.filter(p => existingCardIds.includes(p.cardId))
    
    if (duplicateCardIds.length > 0) {
      console.log(`[Match ${matchId}] ${playerKey} tried to reuse cards:`, duplicateCardIds.map(p => p.cardId))
      return socket.emit('error', { message: 'Эти карты уже были использованы в предыдущих раундах!' })
    }

    // Store placements with round number
    const placementsWithRound = placements.map(p => ({ ...p, round: match.round }))
    match[playerKey].placements = placementsWithRound
    match[playerKey].board = [
      ...(match[playerKey].board || []),
      ...placementsWithRound
    ]
    match[playerKey].confirmed = true

    console.log(`[Match ${matchId}] ${playerKey} placed cards`)

    // Notify opponent that player has moved
    const opponentSocket = isPlayer1 ? match.player2.socket : match.player1.socket
    opponentSocket.emit('opponent_moved')

    // If both players confirmed, reveal and resolve
    if (match.player1.confirmed && match.player2.confirmed) {
      resolveRound(matchId)
    }
  })

  // Handle disconnection
  socket.on('disconnect', async () => {
    console.log(`[Disconnect] User ${userId} disconnected`)
    
    // Remove from queue
    matchmakingQueue.delete(userId)
    userSockets.delete(userId)

    // Handle active match disconnection
    for (const [matchId, match] of activeMatches.entries()) {
      if (match.player1.userId === userId || match.player2.userId === userId) {
        const isPlayer1 = match.player1.userId === userId
        const winner = isPlayer1 ? match.player2 : match.player1
        const winnerSocket = isPlayer1 ? match.player2.socket : match.player1.socket
        
        console.log(`[Match ${matchId}] Player disconnected, winner: ${winner.userId}`)
        
        // Notify the remaining player about opponent disconnect
        if (winnerSocket && winnerSocket.connected) {
          winnerSocket.emit('opponent_disconnect', {
            matchId,
            winner: winner.userId,
            mmrChange: 10 // Small MMR gain for disconnect win
          })
        }
        
        // End match with database updates
        await endMatch(matchId, winner.userId, 'disconnect')
      }
    }
  })
})

// Matchmaking algorithm
function findMatches() {
  if (matchmakingQueue.size < 2) return

  const userIds = Array.from(matchmakingQueue.keys())
  const matchedUserIds = new Set()

  for (let i = 0; i < userIds.length; i++) {
    const userId1 = userIds[i]
    if (matchedUserIds.has(userId1)) continue

    const player1 = matchmakingQueue.get(userId1)
    if (!player1) continue

    const waitTime1 = Date.now() - player1.joinedAt
    const mmrRange1 = Math.min(200 + Math.floor(waitTime1 / 10000) * 50, 500)

    let bestOpponentId = null
    let minMmrDiff = Infinity

    for (let j = i + 1; j < userIds.length; j++) {
      const userId2 = userIds[j]
      if (matchedUserIds.has(userId2)) continue

      const player2 = matchmakingQueue.get(userId2)
      if (!player2) continue

      const mmrDiff = Math.abs(player1.mmr - player2.mmr)
      
      const waitTime2 = Date.now() - player2.joinedAt
      const mmrRange2 = Math.min(200 + Math.floor(waitTime2 / 10000) * 50, 500)
      
      const combinedMmrRange = Math.max(mmrRange1, mmrRange2)

      if (mmrDiff <= combinedMmrRange) {
        if (mmrDiff < minMmrDiff) {
          minMmrDiff = mmrDiff
          bestOpponentId = userId2
        }
      }
    }

    if (bestOpponentId) {
      matchedUserIds.add(userId1)
      matchedUserIds.add(bestOpponentId)
      createMatch(userId1, bestOpponentId)
    }
  }
}

// Create a new match
async function createMatch(player1Id, player2Id) {
  const player1 = matchmakingQueue.get(player1Id)
  const player2 = matchmakingQueue.get(player2Id)

  if (!player1 || !player2) return

  // Remove from queue
  matchmakingQueue.delete(player1Id)
  matchmakingQueue.delete(player2Id)

  const matchId = `match-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`
  
  // Increment match counter
  globalMatchCounter++
  
  // Every 3rd match has empty (neutral) territories
  const shouldBeEmpty = globalMatchCounter % 3 === 0
  const territories = shouldBeEmpty ? generateEmptyTerritories() : await generateTerritories()

  // Ensure all cards have roles
  const p1Deck = player1.deck.map(card => ({
    ...card,
    role: card.role || getCardRole(card)
  }))
  const p2Deck = player2.deck.map(card => ({
    ...card,
    role: card.role || getCardRole(card)
  }))

  const match = {
    matchId,
    player1: {
      userId: player1Id,
      socket: player1.socket,
      deck: p1Deck,
      leaderId: player1.leaderId,
      formation: player1.formation,
      mmr: player1.mmr,
      placements: null,
      board: [],
      confirmed: false
    },
    player2: {
      userId: player2Id,
      socket: player2.socket,
      deck: p2Deck,
      leaderId: player2.leaderId,
      formation: player2.formation,
      mmr: player2.mmr,
      placements: null,
      board: [],
      confirmed: false
    },
    territories,
    round: 1,
    player1Score: 0,
    player2Score: 0,
    startedAt: Date.now()
  }

  activeMatches.set(matchId, match)

  console.log(`[Match] Created ${matchId}: ${player1Id} (${player1.mmr}) vs ${player2Id} (${player2.mmr})`)

  // Notify both players
  player1.socket.emit('match_found', {
    matchId,
    opponentId: player2Id,
    territories,
    yourDeck: player1.deck,
    yourLeaderId: player1.leaderId,
    yourFormation: player1.formation,
    opponentDeck: player2.deck,
    opponentLeaderId: player2.leaderId,
    opponentFormation: player2.formation,
    isPlayer1: true
  })

  player2.socket.emit('match_found', {
    matchId,
    opponentId: player1Id,
    territories,
    yourDeck: player2.deck,
    yourLeaderId: player2.leaderId,
    yourFormation: player2.formation,
    opponentDeck: player1.deck,
    opponentLeaderId: player1.leaderId,
    opponentFormation: player1.formation,
    isPlayer1: false
  })
}

// Generate random territory modifiers
async function generateTerritories() {
  // Check if we need to refresh cache
  if (Date.now() - lastDbUpdate > DB_REFRESH_INTERVAL) {
    await refreshDbCache()
  }

  // Use DB locations if available
  if (dbLocations.length >= 3) {
    const shuffled = [...dbLocations].sort(() => Math.random() - 0.5)
    const selectedLocations = shuffled.slice(0, 3)
    
    return selectedLocations.map(loc => {
      // Find the first rule from dbRules that matches loc.rules
      const ruleId = loc.rules && loc.rules.length > 0 ? loc.rules[0].rule_id : 'none'
      return {
        id: ruleId,
        name: loc.name,
        nameRu: loc.name_ru,
        description: loc.description_ru
      }
    })
  }

  // Fallback to hardcoded modifiers if DB is empty
  const shuffled = TERRITORY_MODIFIERS.sort(() => Math.random() - 0.5)
  return shuffled.slice(0, 3)
}

// Generate empty territory modifiers (every 3rd match)
function generateEmptyTerritories() {
  const neutralModifier = {
    id: "neutral",
    name: "Нейтральная Территория",
    nameRu: "Нейтральная Территория",
    description: "Нет специальных эффектов"
  }
  return [neutralModifier, neutralModifier, neutralModifier]
}

// Resolve round after both players placed cards
async function resolveRound(matchId) {
  const match = activeMatches.get(matchId)
  if (!match) return

  console.log(`[Match ${matchId}] Resolving round ${match.round}`)

  // Prepare deck contexts for synergy calculations on server
  const p1Context = { deck: match.player1.deck, leaderId: match.player1.leaderId, formation: match.player1.formation }
  const p2Context = { deck: match.player2.deck, leaderId: match.player2.leaderId, formation: match.player2.formation }

  // Calculate zone winners
  const zoneWinners = []
  const zoneResults = []

  // Process each zone (3 zones)
  for (let zoneIdx = 0; zoneIdx < 3; zoneIdx++) {
    const zoneId = `zone-${zoneIdx + 1}`
    const territory = match.territories[zoneIdx]

    // Get cards placed on this zone from the current round only
    const p1Placements = (match.player1.board || []).filter(p => p.zoneId === zoneId && p.round === match.round)
    const p2Placements = (match.player2.board || []).filter(p => p.zoneId === zoneId && p.round === match.round)

    console.log(`[Match ${matchId}] Zone ${zoneIdx + 1}: P1 cards=${p1Placements.length}, P2 cards=${p2Placements.length}`)

    // Map placements to ZoneCard structures (so they contain card objects)
    const p1ZoneCards = p1Placements.map((p, index) => {
      const card = match.player1.deck.find(c => c.uniqueId === p.cardId)
      return {
        cardId: p.cardId,
        zoneId: p.zoneId,
        isSecret: false,
        wasSecret: p.isSecret,
        card,
        powerAfterModifier: getCardBasePower(card),
        placementOrder: index,
        isPlayer: true
      }
    })

    const p2ZoneCards = p2Placements.map((p, index) => {
      const card = match.player2.deck.find(c => c.uniqueId === p.cardId)
      return {
        cardId: p.cardId,
        zoneId: p.zoneId,
        isSecret: false,
        wasSecret: p.isSecret,
        card,
        powerAfterModifier: getCardBasePower(card),
        placementOrder: index,
        isPlayer: false
      }
    })

    // Calculate actual powers using calculateCardPowerOnZone
    p1ZoneCards.forEach(zc => {
      if (zc.card) {
        const { power, roleMatchupBonus, synergyBonus } = calculateCardPowerOnZone(zc.card, territory.id, p2ZoneCards, p1ZoneCards, true, zc.wasSecret, true, zc.placementOrder, p1Context)
        zc.powerAfterModifier = power
        zc.roleMatchupBonus = roleMatchupBonus
        zc.synergyBonus = synergyBonus
        console.log(`[Match ${matchId}] P1 Card ${zc.card.name} final power: ${power}, synergy: ${synergyBonus}, matchup: ${roleMatchupBonus}`)
      }
    })

    p2ZoneCards.forEach(zc => {
      if (zc.card) {
        const { power, roleMatchupBonus, synergyBonus } = calculateCardPowerOnZone(zc.card, territory.id, p1ZoneCards, p2ZoneCards, true, zc.wasSecret, true, zc.placementOrder, p2Context)
        zc.powerAfterModifier = power
        zc.roleMatchupBonus = roleMatchupBonus
        zc.synergyBonus = synergyBonus
        console.log(`[Match ${matchId}] P2 Card ${zc.card.name} final power: ${power}, synergy: ${synergyBonus}, matchup: ${roleMatchupBonus}`)
      }
    })

    // Sum power for each side on this zone
    const p1TotalPower = p1ZoneCards.reduce((acc, zc) => acc + zc.powerAfterModifier, 0)
    const p2TotalPower = p2ZoneCards.reduce((acc, zc) => acc + zc.powerAfterModifier, 0)

    // Determine zone winner
    let winner = 'none'
    if (p1TotalPower > p2TotalPower) {
      winner = 'player1'
      match.player1Score++
    } else if (p2TotalPower > p1TotalPower) {
      winner = 'player2'
      match.player2Score++
    }

    console.log(`[Match ${matchId}] Zone ${zoneIdx + 1} winner: ${winner} (P1: ${p1TotalPower} vs P2: ${p2TotalPower})`)

    zoneWinners.push(winner)
    zoneResults.push({
      zoneId,
      zoneName: territory.nameRu,
      winner,
      player1Power: p1TotalPower,
      player2Power: p2TotalPower,
      player1Cards: p1ZoneCards,
      player2Cards: p2ZoneCards
    })
  }

  const results = {
    round: match.round,
    player1Placements: match.player1.placements,
    player2Placements: match.player2.placements,
    zoneWinners,
    zoneResults,
    player1Score: match.player1Score,
    player2Score: match.player2Score
  }

  console.log(`[Match ${matchId}] Round ${match.round} complete. Score: P1=${match.player1Score}, P2=${match.player2Score}`)

  // Broadcast results to both players
  match.player1.socket.emit('round_resolved', results)
  match.player2.socket.emit('round_resolved', results)

  // Check if match is over (3 rounds)
  if (match.round >= 3) {
    // Determine winner based on zones won
    let winnerId
    if (match.player1Score > match.player2Score) {
      winnerId = match.player1.userId
    } else if (match.player2Score > match.player1Score) {
      winnerId = match.player2.userId
    } else {
      // Draw - higher MMR wins
      winnerId = match.player1.mmr >= match.player2.mmr ? match.player1.userId : match.player2.userId
    }
    await endMatch(matchId, winnerId, 'complete')
  } else {
    // Reset for next round
    match.player1.confirmed = false
    match.player2.confirmed = false
    match.player1.placements = null
    match.player2.placements = null
    match.round++

    console.log(`[Match ${matchId}] Starting round ${match.round}`)

    // Notify players to start new round
    match.player1.socket.emit('start_new_round', {
      round: match.round,
      yourDeck: match.player1.deck,
      player1Score: match.player1Score,
      player2Score: match.player2Score
    })

    match.player2.socket.emit('start_new_round', {
      round: match.round,
      yourDeck: match.player2.deck,
      player1Score: match.player1Score,
      player2Score: match.player2Score
    })
  }
}

// End match and update database
async function endMatch(matchId, winnerId, reason) {
  const match = activeMatches.get(matchId)
  if (!match) return

  const loserId = match.player1.userId === winnerId ? match.player2.userId : match.player1.userId
  const winnerMMR = match.player1.userId === winnerId ? match.player1.mmr : match.player2.mmr
  const loserMMR = match.player1.userId === winnerId ? match.player2.mmr : match.player1.mmr

  console.log(`[Match ${matchId}] Ended - Winner: ${winnerId} (${reason})`)

  try {
    // Update MMR in database
    console.log(`[Match ${matchId}] Updating MMR for winner ${winnerId} and loser ${loserId}`)
    const { data: mmrData, error: mmrError } = await supabase.rpc('update_pvp_mmr', {
      p_winner_id: winnerId,
      p_loser_id: loserId,
      p_winner_mmr: winnerMMR,
      p_loser_mmr: loserMMR
    })

    if (mmrError) {
      console.error(`[Match ${matchId}] MMR Update Error:`, mmrError.message || mmrError)
    } else {
      console.log(`[Match ${matchId}] MMR Update Success:`, mmrData)
    }

    const newWinnerMMR = mmrData?.[0]?.winner_new_mmr ?? (winnerMMR + 20)
    const newLoserMMR = mmrData?.[0]?.loser_new_mmr ?? (loserMMR - 20)
    console.log(`[Match ${matchId}] MMR values - Winner: ${newWinnerMMR}, Loser: ${newLoserMMR}`)

    // Log the match
    console.log(`[Match ${matchId}] Inserting PvP log...`)
    const duration = match.startedAt ? Math.floor((Date.now() - match.startedAt) / 1000) : 0
    
    const { data: logData, error: logError } = await supabase.from('pvp_logs').insert({
      player1_id: match.player1.userId,
      player2_id: match.player2.userId,
      winner_id: winnerId,
      player1_mmr_before: match.player1.mmr,
      player2_mmr_before: match.player2.mmr,
      player1_mmr_after: match.player1.userId === winnerId ? newWinnerMMR : newLoserMMR,
      player2_mmr_after: match.player2.userId === winnerId ? newWinnerMMR : newLoserMMR,
      player1_deck: match.player1.deck,
      player2_deck: match.player2.deck,
      duration_seconds: duration,
      battle_data: { 
        reason,
        player1_score: match.player1Score || 0,
        player2_score: match.player2Score || 0,
        rounds: match.round
      }
    }).select()

    if (logError) {
      console.error(`[Match ${matchId}] PvP Log Error:`, logError)
    } else {
      console.log(`[Match ${matchId}] PvP Log Success:`, logData)
    }

    // Notify players (skip if disconnect - already handled with opponent_disconnect event)
    if (reason !== 'disconnect') {
      match.player1.socket.emit('match_ended', {
        winner: winnerId,
        reason,
        mmrChange: match.player1.userId === winnerId ? newWinnerMMR - match.player1.mmr : newLoserMMR - match.player1.mmr
      })

      match.player2.socket.emit('match_ended', {
        winner: winnerId,
        reason,
        mmrChange: match.player2.userId === winnerId ? newWinnerMMR - match.player2.mmr : newLoserMMR - match.player2.mmr
      })
    }
  } catch (err) {
    console.error('[Match] Error ending match:', err)
  }

  activeMatches.delete(matchId)
}

