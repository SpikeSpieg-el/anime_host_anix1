PORT=3100
CORS_ORIGIN=https://weeb-x.com

# Дополнительные хосты, с которых img-сервису разрешено скачивать картинки.
# Через запятую. Нужно для собственных загрузок (обложки/арты/аватары в
# Supabase Storage): общий *.supabase.co в белом списке намеренно закрыт.
# Пример: myproject.supabase.co
EXTRA_ALLOWED_HOSTS=
# Тот же хост можно задать отдельно (можно передать и полный URL проекта).
SUPABASE_STORAGE_HOST=

# Email / SMTP for password reset
# Beget: smtp.beget.com:465 (paid plan required)
# Resend: smtp.resend.com:465 (free, 3000/month — https://resend.com)
# Brevo: smtp-relay.brevo.com:587 (free, 300/day — https://brevo.com)
# Gmail: smtp.gmail.com:465 (free, 500/day — use App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Weeb-X <mail@weeb-x.com>

# Shared secret token to protect /send-email endpoint
# Generate with: openssl rand -hex 32
MAIL_API_TOKEN=
